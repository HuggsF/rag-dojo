# rag-dojo environment variables
# Copy to .env and fill in values
# NOTE: .env lives INSIDE the pod (rag-test), NOT in the local repo.

# === Spiral 01 — Chunks ===

# Groq API (free tier — https://console.groq.com)
# Multiple keys for round-robin rotation (3x rate limit):
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
# Single key fallback (used if GROQ_API_KEYS is not set):
GROQ_API_KEY=gsk_your_key_here

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=rag_dojo_spiral_01

# RAG Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=128
TOP_K=7
SIMILARITY_THRESHOLD=0.3
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM Configuration
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# === Spiral 02 — Graph ===

# Neo4j (graph store)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Graph extraction limits
MAX_ENTITIES_PER_CHUNK=10
MAX_RELATIONS_PER_CHUNK=15
GRAPH_VECTOR_WEIGHT=0.6
GRAPH_GRAPH_WEIGHT=0.4

# Ollama (local LLM fallback — no rate limits, no API key needed)
# Install: winget install Ollama.Ollama && ollama pull mistral:7b
OLLAMA_BASE_URL=http://localhost:11434

# === Spiral 03 — Orchestration ===

# Tension field
ZERO_DELTA_THRESHOLD=0.05
ZERO_DELTA_STREAK_LIMIT=3
TENSION_PROFILE=STANDARD
CONFIDENCE_THRESHOLD=0.3
FALLBACK_MAX_RETRIES=7
MAX_ORCHESTRATION_ROUNDS=5

# === Spiral 04 — Cognitive ===

# Memory store (SQLite)
COGNITIVE_MEMORY_DB=./spiral_04_cognitive/data/memory.db

# YAML config paths (defaults to spiral_04_cognitive/ directory)
# COGNITIVE_PATTERNS_YAML=./spiral_04_cognitive/patterns.yaml
# COGNITIVE_THRESHOLDS_YAML=./spiral_04_cognitive/thresholds.yaml

# Cognitive settings
COGNITIVE_MAX_OUTPUT_LEN=2000
COGNITIVE_HISTORY_LIMIT=100
COGNITIVE_FAIL_STREAK=3

# === Spiral 05 — Economics ===

# Budget database (SQLite)
ECONOMICS_BUDGET_DB=./spiral_05_economics/data/budget.db

# Budget limits (USD)
ECONOMICS_DAILY_BUDGET=5.00
ECONOMICS_MONTHLY_BUDGET=150.00

# Alert thresholds (percentage of budget)
ECONOMICS_ALERT_PCT=80
ECONOMICS_CRITICAL_PCT=95

# Model routing — complexity score thresholds
ECONOMICS_FAST_MAX=0.3
ECONOMICS_STANDARD_MAX=0.7

# Layer pipeline cache
ECONOMICS_CACHE_TTL=3600
ECONOMICS_CACHE_MAX=1000
ECONOMICS_KEYWORD_MIN=0.6

# === Spiral 06 — State of the Art ===

# Cycle limits
SOTA_MAX_CYCLES=3
SOTA_MAX_FILES=5
SOTA_MAX_PRS=3
SOTA_MAX_ECOSYSTEMS=1

# Score thresholds
SOTA_REGRESSION_THRESHOLD=5.0
SOTA_MIN_IMPROVEMENT=0.01

# Benchmark and report paths
# SOTA_BENCHMARK_PATH=./spiral_06_state_of_art/data/benchmark.json
# SOTA_REPORT_PATH=./spiral_06_state_of_art/data/reports
